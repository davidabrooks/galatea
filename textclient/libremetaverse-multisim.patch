     private void Network_OnSimChanged(object? sender, SimChangedEventArgs e)
     {
+        // galatea multisim patch: a border crossing carries her baked appearance and attachments with her (the SL viewer
+        // does not rebake or re-send the outfit on a crossing): keep the appearance state, no new pass
+        if (AgentManager.FastCrossing && Client.Self.CrossingInProgress)
+        {
+            Logger.Info("Region crossing: keeping appearance state (no rebake / outfit re-send)", Client);
+            return;
+        }
         // Cancel any appearance workflow that was running for the previous sim.
         // The new sim will trigger a fresh Simulator_OnCapabilitiesReceived and
         // start a new appearance pass once capabilities are ready.
