<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>galatay-mcp</AssemblyName>
    <RootNamespace>GalatayMcp</RootNamespace>
    <StartupObject>GalatayMcp.McpProgram</StartupObject>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PredefinedCulturesOnly>false</PredefinedCulturesOnly>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <NoWarn>$(NoWarn);CS8632;CS0618;CS7022</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../galatay-text/Program.cs" Link="Core/Program.cs" />
    <Compile Include="../galatay-text/LandDiag.cs" Link="Core/LandDiag.cs" />
    <Compile Include="../galatay-text/HeightGuard.cs" Link="Core/HeightGuard.cs" />
    <Compile Include="../galatay-text/AttachWatch.cs" Link="Core/AttachWatch.cs" />
    <Compile Include="../galatay-text/MuteGuard.cs" Link="Core/MuteGuard.cs" />
    <Compile Include="../galatay-text/NavWalk.cs" Link="Core/NavWalk.cs" />
    <Compile Include="../galatay-text/GroupPicks.cs" Link="Core/GroupPicks.cs" />
    <Compile Include="../galatay-text/RegionRestart.cs" Link="Core/RegionRestart.cs" />
    <Compile Include="../galatay-text/RouteNav.cs" Link="Core/RouteNav.cs" />
    <Compile Include="../galatay-text/Wander.cs" Link="Core/Wander.cs" />
    <Compile Include="../galatay-text/Quiet.cs" Link="Core/Quiet.cs" />
    <Compile Include="../galatay-text/SeatPose.cs" Link="Core/SeatPose.cs" />
    <Compile Include="../galatay-text/AoGuard.cs" Link="Core/AoGuard.cs" />
    <Compile Include="../galatay-text/Watchdog.cs" Link="Core/Watchdog.cs" />
    <Compile Include="../galatay-text/OfflineIm.cs" Link="Core/OfflineIm.cs" />
    <Compile Include="../galatay-text/AttachTrack.cs" Link="Core/AttachTrack.cs" />
    <Compile Include="../galatay-text/WearOps.cs" Link="Core/WearOps.cs" />
    <Compile Include="../galatay-text/AutoFollow.cs" Link="Core/AutoFollow.cs" />
    <Compile Include="../galatay-text/Doors.cs" Link="Core/Doors.cs" />
    <Compile Include="../galatay-text/Outfit.cs" Link="Core/Outfit.cs" />
    <Compile Include="../galatay-text/OutfitSave.cs" Link="Core/OutfitSave.cs" />
    <Compile Include="../galatay-text/NewCmds.cs" Link="Core/NewCmds.cs" />
    <Compile Include="../galatay-text/TextureCmds.cs" Link="Core/TextureCmds.cs" />
    <ProjectReference Include="../src-libremetaverse/LibreMetaverse/LibreMetaverse.csproj" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>
  <!-- Optional proprietary add-on: SL Texture Vision (private repo davidabrooks/sl-texture-vision, git submodule at
       textclient/sl-texture-vision). Present -> 'texture save', 'faces', 'vendor look' work; absent -> they report "not installed". -->
  <PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory)../sl-texture-vision/src/SlTextureVision/SlTextureVision.csproj')">
    <DefineConstants>$(DefineConstants);TEXTURE_VISION</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)../sl-texture-vision/src/SlTextureVision/SlTextureVision.csproj')">
    <ProjectReference Include="../sl-texture-vision/src/SlTextureVision/SlTextureVision.csproj" /> <!-- LibreMetaverseProject: see ../Directory.Build.props -->
  </ItemGroup>
</Project>
