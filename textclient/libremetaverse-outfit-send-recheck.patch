+        /// <summary>(galatay 2026-11-09) A fresh read of the COF (server fetch): every link id and its resolved target id; null if it fails.</summary>
+        async Task<HashSet<UUID>?> CurrentOutfitItemIdsAsync(CancellationToken cancellationToken)
+        {
+            try
+            {
+                var cof = await GetCurrentOutfitFolderAsync(cancellationToken).ConfigureAwait(false);
+                if (cof == null) return null;
+                List<InventoryBase>? contents;
+                using (var cts = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken))
+                {
+                    cts.CancelAfter(TimeSpan.FromSeconds(30));
+                    contents = await Client.Inventory.FolderContentsAsync(cof.UUID, cof.OwnerID, true, true,
+                        InventorySortOrder.ByDate, cts.Token, true).ConfigureAwait(false);
+                }
+                if (contents == null) return null;
+                var ids = new HashSet<UUID>();
+                foreach (var b in contents)
+                {
+                    if (b == null) continue;
+                    ids.Add(b.UUID);
+                    if (b is InventoryItem it) ids.Add(it.ResolvedItemID);
+                }
+                return ids;
+            }
+            catch (OperationCanceledException) when (!cancellationToken.IsCancellationRequested) { return null; }
+            catch (Exception ex) { Logger.Warn("COF re-read failed: " + ex.Message, Client); return null; }
+        }
